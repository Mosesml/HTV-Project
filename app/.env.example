# Copy to app/.env.local (git-ignored) and fill in. Read by app.config.ts.

# Required. Your own suffix, lowercase letters, digits or hyphens.
# Your build's bundle ID becomes com.raveguard.<suffix>.
RG_BUNDLE_SUFFIX=yourname

# Optional. Your 10-character Apple team ID. Leave empty and
# `npx expo run:ios --device` picks a team from your keychain.
RG_APPLE_TEAM_ID=

# Optional. The escalation server (Andy's AN1 deploy), e.g. https://raveguard.example.com.
# Leave empty and the app uses the offline FakeEscalationService: no network, no SMS.
# Rebuild (npm run ios:device) after changing it; it is baked into Info.plist.
RG_SERVER_URL=
