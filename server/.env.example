# The server reads these from its process environment (Railway Variables). No dotenv dependency.
PORT=3000

# SMS is off unless SMS_MODE=live. Leave it unset to simulate: nothing is ever sent.
# SMS_MODE=live
# With SMS_MODE=live the server refuses to start unless ALL of these are set. Real values go
# only in the host's Variables tab, never in a file in the repo.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+14155550100
# The public https origin that recipients' links point at, with no path.
# PUBLIC_BASE_URL=https://your-service.up.railway.app
# Comma-separated E.164 numbers this server may ever text. Sessions are created by a public
# endpoint, so this stops anyone naming an arbitrary number.
# SMS_ALLOWED_RECIPIENTS=+14155550101,+14155550102
